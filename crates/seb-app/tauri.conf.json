{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "seb-dev-tools",
  "version": "0.4.5",
  "identifier": "cn.qkswq.seb.devtools",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "cwd": "ui",
      "script": "trunk serve --port 1420 --address 127.0.0.1"
    },
    "beforeBuildCommand": {
      "cwd": "ui",
      "script": "trunk build --release"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "共享单车调试工具",
        "width": 1125,
        "height": 725,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMjkwRjZFMzEzNTdDRTIKUldUaWZEVXhiZzhwVGwvbDBDM0R4cmpKNmh2ekpBaTJlTzFza2p5azg4Y05nTjMwZlplL1Y3dkcK",
      "endpoints": [
        "https://seb-1305755407.cos.ap-guangzhou.myqcloud.com/seb-dev-tools/releases/latest.json"
      ]
    }
  }
}
